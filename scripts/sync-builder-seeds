#!/usr/bin/env python3
"""The harness package builder's skill carries copies of two things the repository keeps elsewhere: the template package
(`packages/shell`, as the skill's `assets/template`) and the packages guide (`docs/packages.md`, as its
`reference/packages.md`). This copies them in, so the builder always ships the current ones;
`tests/unit/test_packages_shipped.py` fails when they drift. Run it after changing either source."""
import shutil
from pathlib import Path

root = Path(__file__).resolve().parent.parent
skill = root / "packages/harness-package-builder/seeds/home/.claude/skills/harness-package-builder"
COPIES = {root / "packages/shell": skill / "assets/template", root / "docs/packages.md": skill / "reference/packages.md"}

for source, target in COPIES.items():
    if source.is_dir():
        shutil.rmtree(target, ignore_errors=True)
        shutil.copytree(source, target, ignore=shutil.ignore_patterns("__pycache__"))
    else:
        target.parent.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(source, target)
    print(f"{target.relative_to(root)} <- {source.relative_to(root)}")
