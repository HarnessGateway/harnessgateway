# HarnessGateway self-hosted settings, read by compose.yaml. install.sh writes this file with fresh secrets; by hand:
#   docker run --rm ghcr.io/harnessgateway/harnessgateway:3.0.0 keygen >> .env
# Every variable is documented in docs/operations.md.

# Secrets. Keep HG_SECRET_KEY: without it, stored provider keys and secrets cannot be opened.
HG_SECRET_KEY=
HG_OPERATOR_KEY=
HG_DOOR_KEY=

# The Postgres compose runs: its superuser, and the ordinary role the platform connects as.
POSTGRES_ROOT_PASSWORD=
HG_DB_PASSWORD=

# The console (http://HG_BIND:HG_CONSOLE_PORT). It holds no key: people sign in with their platform account; the
# first admin's is created by `init` from HG_ADMIN_EMAIL (install.sh asks when unset). Invitation and SSO links are
# built on HG_CONSOLE_URL, where people open the console; invitations are mailed when HG_SMTP_URL and HG_MAIL_FROM
# are set.
HG_ADMIN_EMAIL=
HG_CONSOLE_PORT=8800
HG_CONSOLE_URL=http://localhost:8800
# HG_SMTP_URL=smtp://user:password@smtp.example.com:587
# HG_MAIL_FROM=HarnessGateway <noreply@example.com>

# Where the API listens on this host. Put TLS in front of it before exposing it beyond localhost.
HG_BIND=127.0.0.1
HG_HTTP_PORT=8000

# Boxes on this host: their directories, and the container runtime (runsc is gVisor; runc runs unisolated).
HG_BOX_DIR=/var/lib/harnessgateway/boxes
HG_SANDBOX_RUNTIME=runsc

# Objects on a local volume by default. For an S3-compatible store (AWS S3, R2, MinIO, ...):
# HG_BLOB_URL=s3://bucket/prefix?endpoint=https://s3.example.com&region=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# A network that re-signs TLS or requires a proxy: the door uses the proxy and trusts the CA.
# HG_UPSTREAM_PROXY=http://proxy.internal:3128
# HG_CA_FILE=/etc/harnessgateway/ca.pem

# Let providers and box egress reach private addresses (a model server on your own network).
HG_ALLOW_PRIVATE_EGRESS=0
