# A node joining an existing control plane (SaaS pool node, or a hybrid node in a customer's own network).
# Run it with deploy/node/run-node.sh on a host prepared by install-gvisor.sh.

# Where the control plane is, and how this node's sandboxes reach the provider gateway (both HTTPS in production)
HG_API_URL=https://api.example.com
HG_GATEWAY_URL=https://gateway.example.com

# A join token from the operator: shared pool (HG_NODE_JOIN_TOKEN on the api, or `harnessgateway node-token`), or
# dedicated to one organization for hybrid (`POST /admin/v1/node-tokens {"org_id": "org_..."}`)
HG_NODE_JOIN_TOKEN=

HG_NODE_NAME=
HG_NODE_SLOTS=8
HG_RUNTIME=runsc
HG_NODE_DIR=/var/lib/harnessgateway
HG_UPLINK_NETWORK=bridge
# HG_CA_FILE=/var/lib/harnessgateway/ca.pem
# HG_UPSTREAM_PROXY=http://proxy.internal:3128
