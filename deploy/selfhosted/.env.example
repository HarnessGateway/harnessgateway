# HarnessGateway self-hosted settings. Generate the three secrets with:
#   docker run --rm harnessgateway/platform:1 keygen >> .env
# Every variable is documented in docs/operations.md.

# Secrets (keep them; losing HG_SECRET_KEY makes every stored provider key unreadable)
HG_SECRET_KEY=
HG_OPERATOR_KEY=
HG_NODE_JOIN_TOKEN=

# Databases and object storage (compose runs both; any Postgres 14+ and any S3 work instead)
POSTGRES_ROOT_PASSWORD=change-me-root
HG_DB_PASSWORD=change-me-app
HG_S3_BUCKET=harnessgateway
HG_S3_ACCESS_KEY=harnessgateway
HG_S3_SECRET_KEY=change-me-s3-secret

# Sign-up: "invite" (organizations redeem invite codes the operator creates) or "closed" (the operator creates them)
HG_SIGNUP=invite

# The sandbox runtime. runsc (gVisor) is required; anything else needs HG_INSECURE_RUNTIME=1 (development only).
HG_RUNTIME=runsc
HG_NODE_SLOTS=4

# Self-hosted only: let providers and sandbox egress reach private addresses (e.g. a model server on your network)
HG_ALLOW_PRIVATE_EGRESS=0

# If your network re-signs TLS (a corporate proxy), mount its CA into the node and point at it:
# HG_CA_FILE=/var/lib/harnessgateway/ca.pem
# HG_UPSTREAM_PROXY=http://proxy.internal:3128

# Pricing (what /v1/usage charges): unit costs in USD per meter, and the markup (default 3)
# HG_PRICES={"compute.vcpu_seconds": 0.000011, "compute.memory_gb_seconds": 0.0000012, "network.egress_bytes": 0.00000000009, "storage.gb_hours": 0.000032}
# HG_MARKUP=3

# Expose the API beyond localhost (put TLS in front of it: see deploy/selfhosted/README.md)
HG_BIND=127.0.0.1
