#!/usr/bin/env python3
"""foobar: a stand-in coding agent CLI. Like every real agent CLI it has its own flags, its own
config file, its own session state and its own event stream, none of them Responses-shaped. Given
a task it thinks, writes a file, runs it, calls an MCP tool if one is configured, and says what it
did, in pieces.

    foobar [--model M] [--system TEXT] [--effort low|medium|high] [--resume] [--state DIR] [--config FILE] TASK

Events, one JSON object per line on stdout (foobar's shapes, not ours):
    {"ev": "think", "text": …}
    {"ev": "tool", "id": …, "name": …, "args": {…}}   then   {"ev": "tool_result", "id": …, "ok": bool, "out": …[, "err": …, "code": …]}
    {"ev": "mcp", "id": …, "server": …, "tool": …, "args": {…}, "out": …}
    {"ev": "say", "delta": …}                           the answer, as it is written
    {"ev": "end", "ok": bool}
"""
import argparse
import json
import os
import subprocess
import sys
import time


def emit(**ev):
    print(json.dumps(ev), flush=True)
    time.sleep(0.03)                                 # so the live relay has something to relay


def main():
    p = argparse.ArgumentParser()
    p.add_argument("--version", action="store_true")
    p.add_argument("--model", default="foobar-1")
    p.add_argument("--system", default="")
    p.add_argument("--effort", default="medium")
    p.add_argument("--resume", action="store_true")
    p.add_argument("--state", default=".foobar")
    p.add_argument("--config", default="")
    p.add_argument("task", nargs="?", default="")
    a = p.parse_args()
    if a.version:
        print("foobar 0.1.0")
        return 0
    config = json.load(open(a.config)) if a.config and os.path.exists(a.config) else {}
    os.makedirs(a.state, exist_ok=True)
    turns = os.path.join(a.state, "turns")
    turn = (int(open(turns).read()) if a.resume and os.path.exists(turns) else 0) + 1
    open(turns, "w").write(str(turn))
    about = [f"turn {turn}", f"model {a.model}", f"effort {a.effort}"]
    if a.system:
        about.append("system: " + a.system.replace("\n", " / ")[:80])
    if config.get("skills"):
        about.append("skills: " + ", ".join(config["skills"]))
    if config.get("mcp"):
        about.append("mcp: " + ", ".join(s["name"] for s in config["mcp"]))
    emit(ev="think", text="; ".join(about))
    if turn == 1:
        emit(ev="tool", id="t1", name="write_file", args={"path": "hello.py", "content": 'print("hello")\n'})
        open("hello.py", "w").write('print("hello")\n')
        emit(ev="tool_result", id="t1", ok=True, out="wrote 15 bytes")
    emit(ev="tool", id="t2", name="run", args={"cmd": "python3 hello.py"})
    r = subprocess.run(["python3", "hello.py"], capture_output=True, text=True)
    emit(ev="tool_result", id="t2", ok=r.returncode == 0, out=r.stdout, err=r.stderr, code=r.returncode)
    for s in config.get("mcp", []):
        emit(ev="mcp", id=f"m-{s['name']}", server=s["name"], tool="lookup", args={"q": a.task[:40]}, out=f"(simulated) {s['name']} answered")
    files = ", ".join(sorted(f for f in os.listdir(".") if not f.startswith(".")))
    if turn == 1:
        text = f"Created hello.py and ran it; it printed {r.stdout.strip()!r}."
    else:
        text = f"Turn {turn}: ran hello.py again; it printed {r.stdout.strip()!r}. Files here: {files}."
    if a.system and "Chase" in a.system:
        text = "Chase, " + text[0].lower() + text[1:]
    for i in range(0, len(text), 24):
        emit(ev="say", delta=text[i:i + 24])
    emit(ev="end", ok=r.returncode == 0)
    return 0 if r.returncode == 0 else 1


if __name__ == "__main__":
    sys.exit(main())
